# Copy to .env.production.local (or set these in your hosting dashboard) for the LIVE site only.
# Both are public build-time values — never put secrets in NEXT_PUBLIC_* variables.

# The final production URL, no trailing slash. Used for canonical URLs, Open Graph URLs,
# sitemap.xml and structured data. Leave empty until the domain is confirmed.
NEXT_PUBLIC_SITE_URL=

# "true" ONLY for the production build. Any other value keeps the site non-indexable
# (robots.txt "Disallow: /" + <meta name="robots" content="noindex">) — the safe default
# for local, preview and staging builds. Indexing also requires NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_ALLOW_INDEXING=false
